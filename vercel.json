{
  "version": 2,
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/index"
    },
    {
      "source": "/api-docs",
      "destination": "/api/index"
    },
    {
      "source": "/api-docs/:match*",
      "destination": "/api/index"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/|assets/|fonts/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
