{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/assets/:filename([\\w-]+)-:hash([\\w-]{8})\\.:ext([a-zA-Z0-9]+)",
      "destination": "/assets/images/:filename.:ext"
    },
    {
      "source": "/src/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/health",
      "destination": "/api/index?path=/health"
    },
    {
      "source": "/api-docs",
      "destination": "/api/index?path=/api-docs/"
    },
    {
      "source": "/api-docs/:match*",
      "destination": "/api/index?path=/api-docs/:match*"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/index?path=/api/:match*"
    },
    {
      "source": "/((?!api/|assets/|fonts/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
