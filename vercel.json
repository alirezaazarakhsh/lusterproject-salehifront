{
  "version": 2,
  "installCommand": "npm install --include=optional --no-package-lock",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api-docs",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api-docs/",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api-docs/:match*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/docs",
      "destination": "/api/index.ts"
    },
    {
      "source": "/health",
      "destination": "/api/index.ts"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!assets/|fonts/|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
