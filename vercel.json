    {
      "source": "/rule",
      "destination": "/index.html"
    },
    {
      "source": "/rule/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/contact-us",
      "destination": "/index.html"
    },
    {
      "source": "/contact-us/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/about-us",
      "destination": "/index.html"
    },
    {
      "source": "/about-us/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/project",
      "destination": "/index.html"
    },
    {
      "source": "/project/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/product",
      "destination": "/index.html"
    },
    {
      "source": "/product/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/index.html"
    },
    {
